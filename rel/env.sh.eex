#!/bin/sh

# The Erlang cookie that `mix release` writes into the image travels with
# the image, and the image is published, so it is no secret. Derive the
# cookie from SECRET_KEY_BASE instead: every installation sets its own,
# and the value comes out the same every time. A later
# `bin/texttile rpc` over `fly ssh` reads the same environment, so it
# still reaches the running node (this is what `make db-pull` does).
#
# Without SECRET_KEY_BASE (a local release, a build step) the cookie the
# release already carries stands, and nothing is said about it.
if [ -n "${SECRET_KEY_BASE:-}" ]; then
  texttile_cookie=$(
    {
      printf 'texttile release cookie %s' "$SECRET_KEY_BASE" |
        { sha256sum || shasum -a 256; } |
        cut -d' ' -f1
    } 2>/dev/null
  )

  if [ -n "$texttile_cookie" ]; then
    export RELEASE_COOKIE="$texttile_cookie"
  fi

  unset texttile_cookie
fi
