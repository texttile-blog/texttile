# Optional local overrides. Copy to .env (git-ignored); dev loads it on every
# start. Real environment variables win over .env values.
# Development needs none of these; they exist for testing real services locally.

# Sender address for outgoing mail (default: texttile@PHX_HOST)
# MAIL_FROM=hello@example.com

# Mail via Resend
# MAIL_ADAPTER=resend
# RESEND_API_KEY=re_...

# Mail via SMTP (STARTTLS on port 587 by default)
# MAIL_ADAPTER=smtp
# SMTP_HOST=mail.example.com
# SMTP_PORT=587
# SMTP_USERNAME=user@example.com
# SMTP_PASSWORD=secret

# Mail via Postmark
# MAIL_ADAPTER=postmark
# POSTMARK_API_KEY=pm_...

# Mail via Brevo
# MAIL_ADAPTER=brevo
# BREVO_API_KEY=xkeysib-...

# Mail via Amazon SES
# MAIL_ADAPTER=ses
# AWS_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
