<!DOCTYPE html>
<html lang={Texttile.I18n.site_locale()}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <%!-- the browser's own chrome sits against the topbar, so it wears
         the topbar's colour, not the page's --%>
    <meta name="theme-color" content={Texttile.Settings.theme_color()} />
    <.live_title default={site_title()} suffix={" · " <> site_title()} phx-no-format>{assigns[:page_title]}</.live_title>
    <.favicon_link />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <%!-- the stored theme, or the iris default: the whole site wears it --%>
    <link rel="stylesheet" href={~p"/theme.css"} />
    <%!-- a module script defers by itself; the editor's heavy chunk
         loads on demand from here, so splitting needs the esm form --%>
    <script phx-track-static type="module" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <%!-- data-words carries what the hooks should say instead of the
       English they are written in. It is "{}" while the site speaks
       English, see TexttileWeb.JsStrings. --%>
  <body data-words={TexttileWeb.JsStrings.json()}>
    {@inner_content}
  </body>
</html>
