<!DOCTYPE html>
<html lang={Texttile.I18n.site_locale()}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <%!-- the browser's own chrome sits against the bar at the top of
         the page, so it wears the bar's colour, not the page's --%>
    <meta name="theme-color" content={Texttile.Settings.theme_color()} />
    <.live_title default={site_title()} suffix={" · " <> site_title()} phx-no-format>{assigns[:page_title]}</.live_title>
    <% description = assigns[:meta_description] || Texttile.Settings.get(:site_description) %>
    <% og_title = Map.get(assigns, :og_title, assigns[:page_title]) %>
    <meta name="description" content={description} />
    <meta property="og:description" content={description} />
    <meta :if={og_title} property="og:title" content={og_title} />
    <meta :if={assigns[:og_image]} property="og:image" content={assigns[:og_image]} />
    <link :if={assigns[:canonical_url]} rel="canonical" href={assigns[:canonical_url]} />
    <meta :if={assigns[:canonical_url]} property="og:url" content={assigns[:canonical_url]} />
    <meta
      :if={assigns[:noindex] || Texttile.Settings.guarded?()}
      name="robots"
      content="noindex, nofollow"
    />
    <.favicon_link />
    <%!-- the feed, for readers who follow from their own reader; a
         blog behind a password offers none --%>
    <link
      :if={Texttile.Feed.public?()}
      rel="alternate"
      type="application/rss+xml"
      title={site_title()}
      href={~p"/feed.xml"}
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <%!-- the stored theme, or the iris default: the whole site wears it --%>
    <link rel="stylesheet" href={~p"/theme.css"} />
    <%!-- a few lines for the search jump and the lightbox keys; every
         page works fully without them --%>
    <script phx-track-static defer src={~p"/assets/js/public.js"}>
    </script>
  </head>
  <%!-- data-count says: report this page to the view counter. It
       stands on the reader pages only, and never while an admin is
       signed in. data-count-entry names the entry the page shows. --%>
  <body
    class="site"
    data-count={assigns[:count_view] && "1"}
    data-count-entry={assigns[:count_entry]}
  >
    {@inner_content}
  </body>
</html>
