<.site_head
  active={@active}
  home_page={@home_page}
  menu_pages={@menu_pages}
  current_scope={@current_scope}
  known={assigns[:known_browser]}
/>
<main>
  <div class="wrap narrow pt-[46px] pb-[var(--tt-sec)]">
    <h1 class="f-h1">{gettext("Nothing here")}</h1>
    <p class="prose !mt-4">
      {gettext("There is no entry at this address.")}
      <a class="link" href={~p"/"}>{gettext("Back to the front page")}</a>.
    </p>
  </div>
  <.site_band current_scope={@current_scope} />
</main>
