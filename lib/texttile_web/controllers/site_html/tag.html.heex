<.site_head
  active={@active}
  home_page={@home_page}
  menu_pages={@menu_pages}
  current_scope={@current_scope}
  known={assigns[:known_browser]}
/>
<main>
  <div class="wrap pt-[18px] sm:pt-[34px] pb-[var(--tt-sec)]">
    <a
      class="link text-[13.5px] text-dim hover:text-accent block w-fit mb-2"
      href={if @home_page, do: ~p"/blog", else: ~p"/"}
    >
      &larr; {gettext("All entries")}
    </a>
    <h1 class="f-h1 inline-flex items-baseline gap-2.5 flex-wrap" id="title">
      <span>#{@tag}</span>
      <span class="font-sans text-[15px] font-normal text-dim num tracking-normal">
        {ngettext("1 entry", "%{count} entries", length(@articles))}
      </span>
    </h1>
    <%!-- every tag of the blog; the active tag carries the underline and
         the count stands once beside the page heading across both widths --%>
    <div class="tagbar-wrap mt-4 mb-6">
      <p
        class="flex gap-x-4"
        id="tagbar"
      >
        <%= for {tag, _count} <- @tags do %>
          <span :if={tag == @tag} class="ctag on" aria-current="page">
            #{tag}
          </span>
          <a :if={tag != @tag} class="ctag" href={~p"/tags/#{String.downcase(tag)}"}>
            #{tag}
          </a>
        <% end %>
      </p>
    </div>

    <div class="cards mt-4" id="texts">
      <.card
        :for={article <- @articles}
        article={article}
        preview={@previews[article.id]}
        comments={@comment_counts[article.id]}
      />
    </div>
  </div>

  <%!-- the second zone: what belongs to the blog and not to the archive --%>
  <.site_band about_html={assigns[:about_html]} current_scope={@current_scope} />
</main>
