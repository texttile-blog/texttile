<.site_head active={@active} home_page={@home_page} menu_pages={@menu_pages} />
<main>
  <article id="text" class="pb-[var(--tt-sec)]">
    <div class="wrap narrow pt-[46px]">
      <h1 class="f-h1">{Articles.display_title(@article)}</h1>
      <%!-- the line under the title: the day, the tags, and for the
           admin who is signed in the way straight into the desk. A page
           has no date and no tags, so there the line is the way in and
           nothing else. --%>
      <p :if={@article.type == "post" || @current_scope} id="meta" class="f-note mt-3">
        <span :if={@article.type == "post"} class="num">
          {format_date(@article.publish_date)}
        </span>
        <span :if={@article.type == "post" && Articles.tag_list(@article) != []}>·</span>
        <span :for={tag <- Articles.tag_list(@article)}>
          <a href={~p"/tags/#{tag}"} class="link">#{tag}</a>
        </span>
        <a
          :if={@current_scope}
          id="edit-text"
          class="edit-link"
          href={~p"/admin/texts/#{@article.id}"}
        >
          Edit
        </a>
      </p>

      <div class="prose" id="body">{body_html(@article)}</div>
    </div>

    <%!-- the gallery: one per text, at the end of it, full width.
         Every tile links the original file, so a crawler finds it;
         the script turns the click into the lightbox, which shows the
         reader size from data-full. Without the script the link stands
         and answers the picture, or the film, itself. A video tile is
         its poster with a play mark; the lightbox plays the film from
         data-video. --%>
    <figure :if={@gallery != []} class="wrap mt-[38px]" id="gallery">
      <div class="gal" id="gal">
        <a
          :for={tile <- @gallery}
          id={"tile-#{tile.id}"}
          href={"/uploads/#{tile.film || tile.original}"}
          data-full={"/renditions/max/#{tile.still}"}
          data-video={tile.film && "/uploads/#{tile.film}"}
          data-caption={tile.filename}
        >
          <img src={"/renditions/640/#{tile.still}"} alt={tile.filename} loading="lazy" />
          <span :if={tile.film} class="play-badge" aria-hidden="true"></span>
        </a>
      </div>
    </figure>

    <%!-- The way along the row of posts: older on the left, newer on
         the right, each with the title it leads to.

         It is drawn as a strip, not as a section: a rule over it and a
         rule under it, the width of the gallery instead of the width
         of the reading column. Nothing else on the page has that left
         edge, so the eye takes it for the end of the text and not for
         the first block under it. It stands first because "keep
         reading" is what most readers want next. --%>
    <div :if={@older || @newer} class="wrap mt-[44px]">
      <nav class="textnav" aria-label="More texts">
        <div class="pv">
          <a :if={@older} id="prev-post" href={Articles.public_path(@older)} rel="prev">
            <span class="lab">Previous text</span>
            <span class="t">{Articles.display_title(@older)}</span>
          </a>
        </div>
        <div class="nx">
          <a :if={@newer} id="next-post" href={Articles.public_path(@newer)} rel="next">
            <span class="lab">Next text</span>
            <span class="t">{Articles.display_title(@newer)}</span>
          </a>
        </div>
      </nav>
    </div>

    <%!-- the comments: what the rule shows to everybody, the reader's
         own waiting ones on top, and the form. No JavaScript in it;
         posting is a plain form round trip. --%>
    <section :if={@comments} class="wrap narrow mt-[54px]" id="comments" aria-label="Comments">
      <%!-- nothing said yet is nothing to head: the section starts at
           the form, and the heading arrives with the first comment --%>
      <h2 :if={@comments != []} id="comment-count" class="f-sec-h mb-4">
        {comment_heading(@comment_count)}
      </h2>
      <p :if={@comment_earlier > 0} class="f-note mb-2">
        The {@comment_earlier} earliest {if @comment_earlier == 1,
          do: "comment is",
          else: "comments are"} not shown here.
      </p>
      <div :if={@comments != []} class="mt-[6px]">
        <div
          :for={{kind, comment} <- @comments}
          class={["py-[14px] border-b border-hair", kind == :own && "opacity-70"]}
          id={"comment-#{comment.id}"}
        >
          <div class="flex flex-wrap gap-[9px] items-baseline text-[13.5px] font-semibold">
            {comment.name}
            <span :if={kind == :own} class="wait">waiting for your confirmation</span>
            <span :if={kind == :shown} class="font-normal text-dim text-[12.5px]">
              {comment_when(comment.inserted_at)}
            </span>
          </div>
          <p class="comment-body mt-[5px] font-serif text-[15.5px] leading-[1.55] max-w-[62ch]">
            {comment.body}
          </p>
          <p :if={kind == :own} class="f-note mt-[6px]">
            Only you see this. Follow the link in the mail and everybody sees it.
          </p>
        </div>
      </div>
      <h2 class={["f-sec-h mb-4", @comments != [] && "mt-10"]}>Post a comment</h2>
      <form id="comment-form" action={~p"/comments/#{@article.id}"} method="post">
        <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
        <input type="hidden" name="t" value={@comment_token} />
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-7 gap-y-4 mb-5">
          <input
            type="text"
            name="name"
            value={@comment_values["name"]}
            placeholder="Name"
            aria-label="Name"
            maxlength="120"
            required
          />
          <input
            type="email"
            name="email"
            value={@comment_values["email"]}
            placeholder="Email, never published"
            aria-label="Email"
            required
          />
        </div>
        <input
          type="text"
          name="website"
          id="hp"
          class="sr"
          tabindex="-1"
          aria-hidden="true"
          autocomplete="off"
        />
        <textarea
          name="body"
          rows="2"
          placeholder="Say something"
          aria-label="Comment"
          maxlength="4000"
          required
        >{@comment_values["body"]}</textarea>
        <p class="f-note mt-4">{@comment_rule}</p>
        <p
          :if={@comment_error}
          class="f-note mt-2"
          id="comment-error"
          style="color:var(--tt-julia)"
        >
          A comment needs a name, an email address and some words. Check the form and send it
          again.
        </p>
        <p class="mt-[10px] btn-row">
          <button class="btn solid">Post comment</button>
          <span :if={@comment_note} class="f-note" id="comment-note">{@comment_note}</span>
        </p>
      </form>
    </section>
  </article>

  <%!-- the second zone: what belongs to the blog and not to the text --%>
  <.site_band about_html={assigns[:about_html]} />
</main>
<.site_foot current_scope={@current_scope} />

<%!-- the lightbox: a count, a way out, an arrow on each side, the
     caption at the foot. public.js fills it from the tiles. --%>
<div
  :if={pictures?(@article, @gallery)}
  class="lb"
  id="lb"
  hidden
  role="dialog"
  aria-modal="true"
  aria-label="Full size"
>
  <div class="lb-bar">
    <span class="num" id="lbCount"></span>
    <span class="sp"></span>
    <button class="lb-btn" type="button" id="lbClose">Close</button>
  </div>
  <div class="lb-stage" id="lbStage">
    <button class="lb-arrow" type="button" id="lbPrev" aria-label="Previous tile">‹</button>
    <div class="lb-img" id="lbArt"></div>
    <button class="lb-arrow" type="button" id="lbNext" aria-label="Next tile">›</button>
  </div>
  <p class="lb-cap" id="lbCap"></p>
</div>
