<.site_head active={@active} home_page={@home_page} menu_pages={@menu_pages} />
<main>
  <%!-- An entry that is not live wears its address for the admins and
       for nobody else. The strip says so before the first line, because
       everything under it looks exactly like the published thing. --%>
  <p :if={not Visibility.live?(@article)} class="notlive" id="not-live">
    <b>{status_word(@article.status)}.</b>
    {gettext(
      "This is the entry as it was last saved. Only somebody signed in can open this address; a reader gets a 404."
    )}
    <a href={~p"/admin/texts/#{@article.id}"}>{gettext("Back to the editor")}</a>
  </p>
  <article id="text" class="pb-[var(--tt-sec)]">
    <div class="wrap narrow pt-[46px]">
      <h1 class="f-h1">{Articles.display_title(@article)}</h1>
      <%!-- the line under the title: the day, the tags, and for the
           admin who is signed in the way straight into the admin area.
           A page has no date and no tags, so there the line is the way
           in and nothing else. --%>
      <p :if={@article.type == "post" || @current_scope} id="meta" class="f-note mt-3">
        <%= if @article.type == "post" do %>
          <span class="num">{format_date(@article.publish_date)}</span>
          <span :if={Articles.tag_list(@article) != []}>·</span>
          <span :for={tag <- Articles.tag_list(@article)}>
            <a href={~p"/tags/#{tag}"} class="link">#{tag}</a>
          </span>
        <% end %>
        <a
          :if={@current_scope}
          id="edit-text"
          class="edit-link"
          href={~p"/admin/texts/#{@article.id}"}
        >
          {gettext("Edit")}
        </a>
      </p>

      <div class="prose" id="body">{body_html(@article)}</div>
    </div>

    <%!-- the gallery: one per text, at the end of it. Four pictures or
         more make the wide grid; fewer keep the width of the text, see
         `gallery_wrap/1`.

         Every tile links the original file, so a crawler finds it;
         the script turns the click into the lightbox, which shows the
         reader size from data-full. Without the script the link stands
         and answers the picture, or the film, itself. A video tile is
         its poster with a play mark; the lightbox plays the film from
         data-video. --%>
    <figure :if={@gallery != []} class={[gallery_wrap(@gallery), "mt-[38px]"]} id="gallery">
      <div class={["gal", gallery_shape(@gallery)]} id="gal">
        <a
          :for={tile <- @gallery}
          id={"tile-#{tile.id}"}
          href={"/uploads/#{tile.film || tile.original}"}
          data-full={"/renditions/max/#{tile.still}"}
          data-video={tile.film && "/uploads/#{tile.film}"}
          data-caption={tile.filename}
        >
          <%!-- one picture fills the reading column, so it gets the
               size a picture in the text gets; a tile of a grid needs
               the card size and no more --%>
          <img
            src={"/renditions/#{gallery_edge(@gallery)}/#{tile.still}"}
            alt={tile.filename}
            loading="lazy"
          />
          <span :if={tile.film} class="play-badge" aria-hidden="true"></span>
        </a>
      </div>
    </figure>

    <%!-- The way along the row of posts: older on the left, newer on
         the right, each with the title it leads to.

         It is drawn as a strip, not as a section: a rule over it and a
         rule under it, the width of the gallery instead of the width
         of the reading column. Nothing else on the page has that left
         edge, so the eye takes it for the end of the text and not for
         the first block under it. It stands first because "keep
         reading" is what most readers want next. --%>
    <div :if={@older || @newer} class="wrap mt-[44px]">
      <nav class="textnav" aria-label={gettext("More entries")}>
        <div class="pv">
          <a :if={@older} id="prev-post" href={Articles.public_path(@older)} rel="prev">
            <span class="lab">{gettext("Previous")}</span>
            <span class="t">{Articles.display_title(@older)}</span>
          </a>
        </div>
        <div class="nx">
          <a :if={@newer} id="next-post" href={Articles.public_path(@newer)} rel="next">
            <span class="lab">{gettext("Next")}</span>
            <span class="t">{Articles.display_title(@newer)}</span>
          </a>
        </div>
      </nav>
    </div>

    <%!-- the comments: what the rule shows to everybody, the reader's
         own waiting ones on top, and the form. No JavaScript in it;
         posting is a plain form round trip. --%>
    <section
      :if={@comments}
      class="wrap narrow mt-[54px]"
      id="comments"
      aria-label={gettext("Comments")}
    >
      <%!-- nothing said yet is nothing to head: the section starts at
           the form, and the heading arrives with the first comment --%>
      <h2 :if={@comments != []} id="comment-count" class="f-sec-h mb-4">
        {comment_heading(@comment_count)}
      </h2>
      <p :if={@comment_earlier > 0} class="f-note mb-2">
        {ngettext(
          "The earliest comment is not shown here.",
          "The %{count} earliest comments are not shown here.",
          @comment_earlier
        )}
      </p>
      <div :if={@comments != []} class="mt-[6px]">
        <div
          :for={{kind, comment} <- @comments}
          class={["py-[14px] border-b border-hair", kind == :own && "opacity-70"]}
          id={"comment-#{comment.id}"}
        >
          <div class="flex flex-wrap gap-[9px] items-baseline text-[13.5px] font-semibold">
            <%!-- the address the author gave for themselves, from the
                 form or out of a bundle. The words are somebody else's,
                 and so is where they lead: the link says as much to a
                 search engine. It stays in the tab, like every other
                 link a reader meets here. --%>
            <a
              :if={comment_website(comment)}
              href={comment_website(comment)}
              class="writer-out"
              rel="nofollow ugc"
            >
              {comment.name}
            </a>
            <span :if={!comment_website(comment)}>{comment.name}</span>
            <span :if={kind == :own} class="wait">
              {gettext("waiting for your confirmation")}
            </span>
            <span :if={kind == :shown} class="font-normal text-dim text-[12.5px]">
              {comment_when(comment.inserted_at)}
            </span>
          </div>
          <p class="comment-body mt-[5px] font-serif text-[15.5px] leading-[1.55] max-w-[62ch]">
            {comment.body}
          </p>
          <p :if={kind == :own} class="f-note mt-[6px]">
            {gettext("Only you see this. Follow the link in the mail and everybody sees it.")}
          </p>
        </div>
      </div>
      <h2 class={["f-sec-h mb-4", @comments != [] && "mt-10"]}>{gettext("Post a comment")}</h2>
      <form id="comment-form" action={~p"/comments/#{@article.id}"} method="post">
        <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
        <input type="hidden" name="t" value={@comment_token} />
        <%!-- signed in, the two fields are facts and not questions: they
             carry what the account says and take no typing. A browser
             sends nothing for a disabled field, and the server takes
             both from the account anyway. --%>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-7 gap-y-4 mb-5">
          <input
            type="text"
            name="name"
            id="comment-name"
            value={(@comment_author && @comment_author.name) || @comment_values["name"]}
            placeholder={gettext("Name")}
            aria-label={gettext("Name")}
            maxlength="120"
            required={!@comment_author}
            disabled={!!@comment_author}
          />
          <input
            type="email"
            name="email"
            id="comment-email"
            value={(@comment_author && @comment_author.email) || @comment_values["email"]}
            placeholder={gettext("Email, not public")}
            aria-label={gettext("Email")}
            required={!@comment_author}
            disabled={!!@comment_author}
          />
        </div>
        <%!-- signed in, this one is a fact too: the comment stands for
             the blog itself, so it carries the address of the blog.

             The placeholder shows the whole address, scheme and all,
             because that is what the field keeps. It stands at the
             front of the line: on a phone the end of a placeholder is
             cut off, and the shape is the half worth reading. --%>
        <input
          type="text"
          name="website"
          id="comment-website"
          class="w-full mb-5"
          value={(@comment_author && @comment_author.website) || @comment_values["website"]}
          placeholder={gettext("https://example.org, if you have one")}
          aria-label={gettext("Website")}
          maxlength="200"
          disabled={!!@comment_author}
        />
        <input
          type="text"
          name="url"
          id="hp"
          class="sr"
          tabindex="-1"
          aria-hidden="true"
          autocomplete="off"
        />
        <textarea
          name="body"
          rows="5"
          placeholder={gettext("Say something")}
          aria-label={gettext("Comment")}
          maxlength="4000"
          required
        >{@comment_values["body"]}</textarea>
        <p class="f-note mt-4">{@comment_rule}</p>
        <p
          :if={@comment_error}
          class="f-note mt-2"
          id="comment-error"
          style="color:var(--tt-julia)"
        >
          {gettext(
            "A comment needs a name, an email address and some words, and a website has to read like example.org. Check the form and send it again."
          )}
        </p>
        <p class="mt-[10px] btn-row">
          <button class="btn solid">{gettext("Post comment")}</button>
          <span :if={@comment_note} class="f-note" id="comment-note">{@comment_note}</span>
        </p>
      </form>
    </section>
  </article>

  <%!-- the second zone: what belongs to the blog and not to the text --%>
  <.site_band about_html={assigns[:about_html]} />
</main>
<.site_foot current_scope={@current_scope} />

<%!-- the lightbox: a count, a way out, an arrow on each side, the
     caption at the foot. public.js fills it from the tiles. --%>
<div
  :if={pictures?(@article, @gallery)}
  class="lb"
  id="lb"
  hidden
  role="dialog"
  aria-modal="true"
  aria-label={gettext("Full size")}
>
  <div class="lb-bar">
    <span class="num" id="lbCount"></span>
    <span class="sp"></span>
    <button class="lb-btn" type="button" id="lbClose">{gettext("Close")}</button>
  </div>
  <div class="lb-stage" id="lbStage">
    <button class="lb-arrow" type="button" id="lbPrev" aria-label={gettext("Previous tile")}>
      ‹
    </button>
    <div class="lb-img" id="lbArt"></div>
    <button class="lb-arrow" type="button" id="lbNext" aria-label={gettext("Next tile")}>
      ›
    </button>
  </div>
  <p class="lb-cap" id="lbCap"></p>
</div>
