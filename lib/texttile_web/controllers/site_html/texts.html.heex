<.site_head active={@active} home_page={@home_page} menu_pages={@menu_pages} />
<main>
  <div class="wrap pt-[46px] pb-[var(--tt-sec)]">
    <h1 class="f-h1">Blog Entries</h1>

    <div class="searchrow mt-7">
      <form action={@list_path} method="get" role="search">
        <label for="q" class="sr">Search the texts</label>
        <input
          type="search"
          id="q"
          name="q"
          value={@q}
          placeholder="Search titles, tags and text"
          autocomplete="off"
          spellcheck="false"
        />
      </form>
      <a :if={@q != "" || @year} class="btn sm" id="clear" href={@list_path}>Clear</a>
      <span class="cnt" id="count">{count_label(@found, @total)}</span>
    </div>

    <%!-- the archive: one line of years, and the months of the year
         that is open under it. Two lines, whatever the age of the blog.
         The counts follow the search, so a year that holds nothing for
         the term goes quiet instead of lying about it. --%>
    <nav :if={@years != []} class="periods" id="periods" aria-label="Archive">
      <p class="prow" id="years">
        <.period label="All years" on={is_nil(@year)} href={@period_path.(nil, nil)} count={@total} />
        <.period
          :for={{year, count} <- @years}
          label={year}
          on={@year == year}
          href={@period_path.(year, nil)}
          count={count}
        />
      </p>
      <p :if={@months != []} class="prow" id="months">
        <.period
          label="All months"
          on={is_nil(@month)}
          href={@period_path.(@year, nil)}
          count={Enum.sum(Enum.map(@months, &elem(&1, 1)))}
        />
        <%!-- no count under a month: twelve numbers in a row is a
             table, not a line --%>
        <.period
          :for={{month, _count} <- @months}
          label={Articles.month_name(month)}
          on={@month == month}
          href={@period_path.(@year, month)}
        />
      </p>
    </nav>

    <div class="cards" id="texts">
      <.card
        :for={article <- @articles}
        article={article}
        preview={@previews[article.id]}
        comments={@comment_counts[article.id]}
      />
    </div>

    <%!-- the pager: one step each way, and where the reader stands.
         The page size lives in Settings. --%>
    <nav
      :if={@pages > 1}
      class="f-pager mt-10 pt-4 border-t border-rule"
      id="pager"
      aria-label="Pages"
    >
      <%!-- three cells, always: the step back, where the reader
           stands, the step on. An empty cell keeps the middle one in
           the middle at either end of the row. --%>
      <span>
        <a :if={@page > 1} class="btn sm" id="prev-page" href={@page_path.(@page - 1)} rel="prev">
          Newer texts
        </a>
      </span>
      <span class="f-note num">Page {@page} of {@pages}</span>
      <span>
        <a
          :if={@page < @pages}
          class="btn sm"
          id="next-page"
          href={@page_path.(@page + 1)}
          rel="next"
        >
          Older texts
        </a>
      </span>
    </nav>

    <p :if={@articles == [] && @q != ""} class="f-body mt-8" id="empty">
      Nothing matches that. <a class="link" href={@list_path}>Show all texts</a>.
    </p>
    <p :if={@articles == [] && @q == ""} class="f-body mt-8">Nothing here yet.</p>
  </div>

  <%!-- the second zone: what belongs to the blog and not to the list --%>
  <.site_band about_html={assigns[:about_html]} />
</main>
<.site_foot current_scope={@current_scope} />
