<.site_head active={@active} home_page={@home_page} menu_pages={@menu_pages} />
<main>
  <div class="wrap pt-[46px] pb-[var(--tt-sec)]">
    <h1 class="f-h1">{gettext("Blog Entries")}</h1>

    <%!-- the list is narrowed from under it, so a reader who lands on
         a year or a term reads here why the list is shorter than the
         blog, and finds the way back --%>
    <p :if={@q != "" || @year} class="f-note mt-3" id="narrowed">
      {narrowed(@q, @year, @month)}
      <a class="link" href={@list_path}>{gettext("Show all entries")}</a>
    </p>

    <div class="cards mt-9" id="texts">
      <.card
        :for={article <- @articles}
        article={article}
        preview={@previews[article.id]}
        comments={@comment_counts[article.id]}
      />
    </div>

    <%!-- the pager: one step each way, and where the reader stands.
         The page size lives in Settings. --%>
    <nav
      :if={@pages > 1}
      class="f-pager mt-10 pt-4 border-t border-rule"
      id="pager"
      aria-label={gettext("Pages")}
    >
      <%!-- three cells, always: the step back, where the reader
           stands, the step on. An empty cell keeps the middle one in
           the middle at either end of the row. --%>
      <span>
        <a :if={@page > 1} class="btn sm" id="prev-page" href={@page_path.(@page - 1)} rel="prev">
          {gettext("Newer")}
        </a>
      </span>
      <span class="f-note num">
        {gettext("Page %{page} of %{pages}", page: @page, pages: @pages)}
      </span>
      <span>
        <a
          :if={@page < @pages}
          class="btn sm"
          id="next-page"
          href={@page_path.(@page + 1)}
          rel="next"
        >
          {gettext("Older")}
        </a>
      </span>
    </nav>

    <p :if={@articles == [] && @q != ""} class="f-body mt-8" id="empty">
      {gettext("Nothing matches that.")}
      <a class="link" href={@list_path}>{gettext("Show all entries")}</a>.
    </p>
    <p :if={@articles == [] && @q == ""} class="f-body mt-8">{gettext("Nothing here yet.")}</p>

    <%!-- the way through the archive, under the list: the field, the
         year, the month of the year that is open, and the count. One
         form, so Enter in the field keeps the year, and a change of
         year goes with the term (public.js submits it). The counts in
         the choices follow the search, so a year that holds nothing
         for the term says so instead of lying about it. --%>
    <form
      class="searchrow mt-14 pt-7 border-t border-rule"
      id="archive"
      action={@list_path}
      method="get"
      role="search"
    >
      <label for="q" class="sr">{gettext("Search the entries")}</label>
      <input
        type="search"
        id="q"
        name="q"
        value={@q}
        placeholder={gettext("Search titles, tags and text")}
        autocomplete="off"
        spellcheck="false"
      />
      <label :if={@years != []} for="year" class="sr">{gettext("Year")}</label>
      <span :if={@years != []} class="pick">
        <select name="y" id="year">
          <option value="">{gettext("All years")}</option>
          <option :for={{year, count} <- @years} value={year} selected={@year == year}>
            {year} ({count})
          </option>
        </select>
      </span>
      <label :if={@months != []} for="month" class="sr">{gettext("Month")}</label>
      <span :if={@months != []} class="pick">
        <select name="m" id="month">
          <option value="">{gettext("All months")}</option>
          <option :for={{month, _count} <- @months} value={month} selected={@month == month}>
            {Texttile.I18n.month_name(month)}
          </option>
        </select>
      </span>
      <span class="cnt" id="count">{entry_count(@found, @total)}</span>
    </form>
  </div>

  <%!-- the second zone: what belongs to the blog and not to the list --%>
  <.site_band about_html={assigns[:about_html]} />
</main>
<.site_foot current_scope={@current_scope} />
