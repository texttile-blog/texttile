<main class="min-h-[100dvh] flex items-start justify-center px-5 pt-[13vh] pb-10">
  <div class="w-[min(374px,100%)]">
    <div class="flex items-center gap-[11px]">
      <Layouts.mark size={28} ink="var(--tt-ink)" />
      <h1 class="font-serif text-[26px] font-semibold tracking-[-.02em]">
        {Texttile.Settings.site_title()}
      </h1>
    </div>
    <p class="text-faint text-[13px] mt-[6px]">This blog asks for its password.</p>
    <form id="unlock" action={~p"/unlock"} method="post" class="mt-[26px]">
      <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
      <input type="hidden" name="to" value={@to} />
      <label class="lab block mb-[5px]" for="password">Password</label>
      <input
        type="password"
        id="password"
        name="password"
        autofocus
        autocomplete="current-password"
      />
      <p
        :if={@error}
        id="unlock-error"
        class="text-[12.5px] mt-[7px]"
        style="color:var(--tt-julia)"
      >
        That is not the password. Check it and try again.
      </p>
      <button type="submit" class="btn solid w-full mt-[15px] h-[34px]">Read on</button>
    </form>
    <p class="note mt-[18px] leading-[1.6]">
      One password opens the whole blog, and this browser remembers it.
      If you do not have it, ask the person who gave you the address.
    </p>
  </div>
</main>
