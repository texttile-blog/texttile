<%!-- The card stands in the middle of the page and everything on it
     stands in the middle of the card: the mark, the title, the one
     line that says why, and the field. Nothing here is a form to work
     through, so nothing needs a left edge to run down. --%>
<%!-- The card is placed with a margin and not with a flex rule: the
     site layout makes every `main` a flex column of its own
     (`body.site > main`), which turned `justify-center` into vertical
     centring and left the card against the left edge. --%>
<main class="min-h-[100dvh] px-5 pt-[13vh] pb-10">
  <div class="w-[min(374px,100%)] mx-auto text-center">
    <div class="flex items-center justify-center gap-[11px]">
      <Layouts.mark size={28} ink="var(--tt-ink)" />
      <h1 class="font-serif text-[26px] font-semibold tracking-[-.02em]">
        {Texttile.Settings.site_title()}
      </h1>
    </div>
    <p class="text-faint text-[13px] mt-[6px]">{gettext("This blog asks for its password.")}</p>
    <form id="unlock" action={~p"/unlock"} method="post" class="mt-[26px]">
      <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
      <input type="hidden" name="to" value={@to} />
      <label class="lab block mb-[5px]" for="password">{gettext("Password")}</label>
      <input
        type="password"
        id="password"
        class="text-center"
        name="password"
        autofocus
        autocomplete="current-password"
      />
      <p
        :if={@error}
        id="unlock-error"
        class="text-[12.5px] mt-[7px]"
        style="color:var(--tt-julia)"
      >
        {if @error == :too_many,
          do: gettext("Too many tries. Wait a minute, then try again."),
          else: gettext("That is not the password. Check it and try again.")}
      </p>
      <button type="submit" class="btn solid w-full mt-[15px] h-[34px]">
        {gettext("Read on")}
      </button>
    </form>
  </div>
</main>
