#: lib/texttile_web/live/settings_live.ex:1033
#: lib/texttile_web/live/settings_live.ex:1063
#, elixir-autogen, elixir-format
msgid "The value must be %{rule}."
msgstr "Der Wert muss %{rule}."

#: lib/texttile_web/live/settings_live.ex:579
#, elixir-autogen, elixir-format
